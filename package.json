{
  "name": "blocks-explorer",
  "version": "0.1.0",
  "type": "module",
  "blocksTemplate": "react",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "aws-blocks",
    "custom-blocks/location-map"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx watch aws-blocks/scripts/server.ts",
    "dev": "tsx watch aws-blocks/scripts/server.ts",
    "sandbox": "tsx aws-blocks/scripts/sandbox.ts",
    "sandbox:destroy": "tsx -C cdk aws-blocks/scripts/sandbox-destroy.ts",
    "sandbox:console": "tsx aws-blocks/scripts/console.ts",
    "cleanup": "tsx aws-blocks/scripts/cleanup.ts",
    "prebuild": "blocks-generate-client",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "tsx aws-blocks/scripts/deploy.ts",
    "secret": "tsx aws-blocks/scripts/secret.ts",
    "typegen": "tsx aws-blocks/scripts/typegen.ts",
    "destroy": "tsx aws-blocks/scripts/destroy.ts",
    "hard-destroy": "tsx -C cdk aws-blocks/scripts/hard-destroy.ts",
    "vendorize": "blocks-vendorize"
  },
  "dependencies": {
    "@aws-blocks/blocks": "0.6.0",
    "@aws-blocks/hosting": "0.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.65.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "aws-cdk": "^2.1138.0",
    "aws-cdk-lib": "2.260.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.27.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^6.4.3"
  },
  "overrides": {
    "@aws-blocks/core": "0.5.0",
    "@aws-blocks/pipeline": "0.2.2",
    "@aws-blocks/hosting": "0.3.1",
    "@aws-blocks/bb-distributed-table": "0.2.0",
    "@aws-blocks/bb-logger": "0.2.0",
    "@aws-blocks/bb-distributed-data": "0.2.0",
    "@aws-blocks/data-common": "0.1.5",
    "@aws-blocks/bb-lambda-compute": "0.5.0",
    "@aws-blocks/bb-knowledge-base": "0.2.4",
    "@aws-blocks/bb-email-client": "0.1.7",
    "@aws-blocks/bb-auth-cognito": "0.1.10",
    "@aws-blocks/bb-app-setting": "0.3.0",
    "@aws-blocks/bb-kv-store": "0.2.0",
    "@aws-blocks/auth-common": "0.1.8",
    "@aws-blocks/bb-file-bucket": "0.2.1",
    "@aws-blocks/bb-auth-basic": "0.1.9",
    "@aws-blocks/bb-dashboard": "0.2.0",
    "@aws-blocks/bb-auth-oidc": "0.2.0",
    "@aws-blocks/bb-async-job": "0.2.1",
    "@aws-blocks/bb-realtime": "0.2.1",
    "@aws-blocks/bb-cron-job": "0.2.1",
    "@aws-blocks/bb-metrics": "0.1.7",
    "@aws-blocks/bb-tracer": "0.2.0",
    "@aws-blocks/bb-agent": "0.4.1",
    "@aws-blocks/bb-data": "0.3.0"
  },
  "blocksTemplateVersion": "0.1.0"
}
