{
  "name": "blocks-explorer",
  "version": "0.1.0",
  "type": "module",
  "blocksTemplate": "react",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "cdk-blocks",
    "custom-blocks/location-map"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:server": "cdk-blocks dev",
    "dev": "cdk-blocks dev",
    "sandbox": "cdk-blocks sandbox",
    "sandbox:deploy": "cdk-blocks sandbox deploy",
    "sandbox:destroy": "cdk-blocks sandbox destroy",
    "sandbox:console": "cdk-blocks sandbox console",
    "cleanup": "cdk-blocks dev stop --all",
    "prebuild": "blocks-generate-client",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "cdk-blocks deploy",
    "secret": "cdk-blocks secret",
    "typegen": "cdk-blocks generate types",
    "destroy": "cdk-blocks destroy",
    "hard-destroy": "tsx -C cdk cdk-blocks/scripts/hard-destroy.ts",
    "vendorize": "blocks-vendorize",
    "docs": "cdk-blocks docs",
    "docs:search": "cdk-blocks docs --search",
    "docs:api": "cdk-blocks docs --api",
    "db": "cdk-blocks db",
    "whoami": "cdk-blocks whoami",
    "migrate": "cdk-blocks migrate",
    "help": "cdk-blocks --help",
    "generate-client": "cdk-blocks generate client"
  },
  "dependencies": {
    "@aws-cdk-blocks/hosting": "1.0.0",
    "aws-cdk-blocks": "1.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.65.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "aws-cdk": "^2.1138.0",
    "aws-cdk-lib": "2.260.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.27.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^6.4.3"
  },
  "overrides": {
    "@aws-cdk-blocks/core": "1.0.1",
    "@aws-cdk-blocks/pipeline": "1.0.0",
    "@aws-cdk-blocks/hosting": "1.0.0",
    "@aws-cdk-blocks/bb-auth": "1.0.0",
    "@aws-cdk-blocks/auth-common": "1.0.0",
    "@aws-cdk-blocks/bb-agent": "1.0.0",
    "@aws-cdk-blocks/bb-logger": "1.0.0",
    "@aws-cdk-blocks/bb-secret": "1.0.0",
    "@aws-cdk-blocks/bb-tracer": "1.0.0",
    "@aws-cdk-blocks/bb-compute": "1.0.0",
    "@aws-cdk-blocks/bb-metrics": "1.0.0",
    "@aws-cdk-blocks/bb-cron-job": "1.0.0",
    "@aws-cdk-blocks/bb-database": "1.0.0",
    "@aws-cdk-blocks/bb-kv-store": "1.0.0",
    "@aws-cdk-blocks/bb-realtime": "1.0.0",
    "@aws-cdk-blocks/bb-async-job": "1.0.0",
    "@aws-cdk-blocks/bb-dashboard": "1.0.0",
    "@aws-cdk-blocks/bb-app-setting": "1.0.0",
    "@aws-cdk-blocks/bb-file-bucket": "1.0.0",
    "@aws-cdk-blocks/bb-email-client": "1.0.0",
    "@aws-cdk-blocks/bb-knowledge-base": "1.0.0",
    "@aws-cdk-blocks/bb-lambda-compute": "1.0.0",
    "@aws-cdk-blocks/bb-container-compute": "1.0.0"
  },
  "blocksTemplateVersion": "0.1.0",
  "blocks": {
    "dev": {
      "frontendPort": 3100
    }
  }
}
