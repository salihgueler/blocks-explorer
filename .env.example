# Copy this file to `.env.production` (gitignored) and fill in the value.
# `npm run deploy` loads `.env.production` and injects this into the backend
# Lambda; the deployed app's map uses it. Local dev (`npm run dev`) does NOT
# need this — it renders the bundled offline SVG map.

# Google Maps JavaScript API key.
# Create one in Google Cloud Console with the "Maps JavaScript API" enabled,
# then restrict it by HTTP referrer to your CloudFront domain (and localhost
# if desired) and by API to Maps JavaScript API.
GOOGLE_MAPS_API_KEY=
